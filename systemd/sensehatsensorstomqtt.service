[Unit]
Description=Sense HAT sensors to MQTT
Documentation=https://github.com/hellqvio86/sense-hat-sensors-to-mqtt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sensehatsensorstomqtt
Restart=on-failure
RestartSec=5
WatchdogSec=180

# Disable Python's buffering of STDOUT and STDERR so logs appear immediately
Environment=PYTHONUNBUFFERED=1

# Run as dedicated unprivileged user with hardware groups required by Sense HAT
User=sensehat
Group=sensehat
SupplementaryGroups=i2c video input

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
