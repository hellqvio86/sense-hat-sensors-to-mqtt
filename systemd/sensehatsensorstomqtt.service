# systemd unit file for the Python Demo Service


[Unit]

# Human readable name of the unit
Description=Sense hat sensors to MQTT
After=network.target
Wants=network.target

[Service]
Type=forking
RemainAfterExit=yes

# Command to execute when the service is started
#ExecStart=/home/pi/git/sense-hat-sensors-to-mqtt/run.sh
#ExecStart=python3 /home/pi/git/sense-hat-sensors-to-mqtt/src/sensehatsensorstomqtt/__main__.py --config_file /etc/sensehatsensorstomqtt.yaml --daemon
ExecStart=/home/pi/git/sense-hat-sensors-to-mqtt/daemon.sh
ExecStop=pkill -F /run/sensehatsensorstomqtt/sensehatsensorstomqtt.pid

# Disable Python's buffering of STDOUT and STDERR, so that output from the
# service shows up immediately in systemd's logs
Environment=PYTHONUNBUFFERED=1

# Automatically restart the service if it crashes
Restart=on-failure

StandardInput=tty-force

# Use a dedicated user to run our service
User=pi
Group=pi

PIDFile=/run/sensehatsensorstomqtt/sensehatsensorstomqtt.pid
StandardOutput=syslog

TimeoutStartSec=600

[Install]

# Tell systemd to automatically start this service when the system boots
# (assuming the service is enabled)
WantedBy=multi-user.target